# Backend routing profile from config/backends.json
# Profiles: wiremock (default), dev (alias of wiremock), local, production
NEOCOM_PROFILE=wiremock

# Node Express listen port (server.js / start:node)
PORT=3000

# Optional URL overrides (apply on top of the selected profile)
WIREMOCK_URL=http://localhost:8080
BACKEND_URL=http://localhost:8090
NEST_URL=http://localhost:3001
