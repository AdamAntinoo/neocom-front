{
  "name": "neocom-front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "NG_BUILD_SASS_EMBEDDED=0 bash scripts/with-neocom-node.sh ng serve",
    "start:dev": "NG_BUILD_SASS_EMBEDDED=0 bash scripts/with-neocom-node.sh ng serve --configuration development",
    "start:node": "bash scripts/with-neocom-node.sh node server.js",
    "start:server": "bash scripts/with-neocom-node.sh node server.js",
    "start:prod": "NG_BUILD_SASS_EMBEDDED=0 bash scripts/with-neocom-node.sh bash -c 'ng build && node server.js'",
    "build": "NG_BUILD_SASS_EMBEDDED=0 ng build",
    "watch": "NG_BUILD_SASS_EMBEDDED=0 ng build --watch --configuration development",
    "test": "NG_BUILD_SASS_EMBEDDED=0 ng test",
    "test:pilot": "node --test test/pilot-character.test.mjs",
    "e2e": "cypress run",
    "e2e:open": "cypress open",
    "banner": "bash scripts/with-neocom-node.sh node scripts/generate-banner.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "compression": "^1.8.2",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "http-proxy-middleware": "^3.0.7",
    "neocom-domain": "^0.29.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@badeball/cypress-cucumber-preprocessor": "^28.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "cypress": "^16.1.1",
    "esbuild": "^0.28.2",
    "figlet": "^1.12.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "cypress/e2e/step_definitions/**/*.{js,ts}"
    ]
  },
  "allowScripts": {
    "cypress@16.1.1": true,
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.3": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
