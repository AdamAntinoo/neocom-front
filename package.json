{
  "name": "neocom-front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "NG_BUILD_SASS_EMBEDDED=0 ng serve",
    "start:dev": "NG_BUILD_SASS_EMBEDDED=0 ng serve --configuration development",
    "build": "NG_BUILD_SASS_EMBEDDED=0 ng build",
    "watch": "NG_BUILD_SASS_EMBEDDED=0 ng build --watch --configuration development",
    "test": "NG_BUILD_SASS_EMBEDDED=0 ng test",
    "e2e": "cypress run",
    "e2e:open": "cypress open"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@badeball/cypress-cucumber-preprocessor": "^28.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "cypress": "^16.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "cypress/e2e/step_definitions/**/*.{js,ts}"
    ]
  },
  "allowScripts": {
    "cypress@16.1.1": true,
    "esbuild@0.28.2": true
  }
}
