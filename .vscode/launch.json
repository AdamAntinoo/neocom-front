{
  // servePath/baseHref is /app/ — without pathMapping, js-debug looks under
  // …/app/src/… and breakpoints stay unbound.
  // Absolute webRoot: this Cursor workspace is multi-root; ${workspaceFolder}
  // alone can resolve to the wrong project.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ng serve (attach browser)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:6001/app/",
      "webRoot": "/Users/adam/IdeaProjects/E.NEOCOM/neocom-front",
      "sourceMaps": true,
      "pathMapping": {
        "/app": "/Users/adam/IdeaProjects/E.NEOCOM/neocom-front"
      },
      "sourceMapPathOverrides": {
        "*": "/Users/adam/IdeaProjects/E.NEOCOM/neocom-front/*"
      }
    },
    {
      "name": "ng serve",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: start",
      "url": "http://localhost:6001/app/",
      "webRoot": "/Users/adam/IdeaProjects/E.NEOCOM/neocom-front",
      "sourceMaps": true,
      "pathMapping": {
        "/app": "/Users/adam/IdeaProjects/E.NEOCOM/neocom-front"
      },
      "sourceMapPathOverrides": {
        "*": "/Users/adam/IdeaProjects/E.NEOCOM/neocom-front/*"
      }
    },
    {
      "name": "ng test",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: test",
      "url": "http://localhost:9876/debug.html"
    }
  ]
}
