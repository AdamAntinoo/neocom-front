{
  // Vite + servePath `/app/` makes js-debug look for <project>/app/src/...
  // (https://github.com/microsoft/vscode/issues/303498). Overrides often fail.
  //
  // Local fix already applied: symlink `app` → `.` (gitignored). Recreate with:
  //   cd neocom-front && ln -sfn . app
  //
  // IMPORTANT for binding: set breakpoints on files under app/src/...
  // (same files as src/..., path matches what the debugger resolves).
  // Or open Chrome DevTools → Sources and break there (always works).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ng serve (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:6001/app/",
      "webRoot": "/Users/adam/IdeaProjects/E.NEOCOM/neocom-front",
      "sourceMaps": true,
      "pathMapping": {
        "/app": "/Users/adam/IdeaProjects/E.NEOCOM/neocom-front",
        "/Users/adam/IdeaProjects/E.NEOCOM/neocom-front/app": "/Users/adam/IdeaProjects/E.NEOCOM/neocom-front"
      },
      "resolveSourceMapLocations": [
        "/Users/adam/IdeaProjects/E.NEOCOM/neocom-front/**",
        "!**/node_modules/**"
      ],
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "ng serve (Chrome + start)",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: start",
      "url": "http://localhost:6001/app/",
      "webRoot": "/Users/adam/IdeaProjects/E.NEOCOM/neocom-front",
      "sourceMaps": true,
      "pathMapping": {
        "/app": "/Users/adam/IdeaProjects/E.NEOCOM/neocom-front",
        "/Users/adam/IdeaProjects/E.NEOCOM/neocom-front/app": "/Users/adam/IdeaProjects/E.NEOCOM/neocom-front"
      },
      "resolveSourceMapLocations": [
        "/Users/adam/IdeaProjects/E.NEOCOM/neocom-front/**",
        "!**/node_modules/**"
      ],
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "ng test",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: test",
      "url": "http://localhost:9876/debug.html",
      "webRoot": "/Users/adam/IdeaProjects/E.NEOCOM/neocom-front"
    }
  ]
}
