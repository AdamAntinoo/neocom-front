{
  "defaultProfile": "wiremock",
  "server": {
    "port": 3000,
    "appName": "NEOCOM Front"
  },
  "profiles": {
    "wiremock": {
      "staticRoot": "dist/neocom-front/browser",
      "spaBasePath": "/",
      "routes": [
        { "path": "/api", "target": "http://localhost:8080", "label": "wiremock", "envKey": "WIREMOCK_URL" },
        { "path": "/nin/v1", "target": "http://localhost:8080", "label": "wiremock", "envKey": "WIREMOCK_URL" },
        { "path": "/esi/v1", "target": "http://localhost:8080", "label": "wiremock", "envKey": "WIREMOCK_URL" }
      ]
    },
    "dev": {
      "staticRoot": "dist/neocom-front/browser",
      "spaBasePath": "/",
      "routes": [
        { "path": "/api", "target": "http://localhost:8080", "label": "wiremock", "envKey": "WIREMOCK_URL" },
        { "path": "/nin/v1", "target": "http://localhost:8080", "label": "wiremock", "envKey": "WIREMOCK_URL" },
        { "path": "/esi/v1", "target": "http://localhost:8080", "label": "wiremock", "envKey": "WIREMOCK_URL" }
      ]
    },
    "local": {
      "staticRoot": "dist/neocom-front/browser",
      "spaBasePath": "/",
      "routes": [
        { "path": "/api", "target": "http://localhost:8090", "label": "backend", "envKey": "BACKEND_URL" },
        { "path": "/nin/v1", "target": "http://localhost:3001", "label": "nest", "envKey": "NEST_URL" },
        { "path": "/esi/v1", "target": "http://localhost:3001", "label": "nest", "envKey": "NEST_URL" }
      ]
    },
    "production": {
      "staticRoot": "dist/neocom-front/browser",
      "spaBasePath": "/",
      "routes": [
        { "path": "/api", "target": "http://localhost:8080", "label": "backend", "envKey": "BACKEND_URL" },
        { "path": "/nin/v1", "target": "http://localhost:8080", "label": "nest", "envKey": "NEST_URL" },
        { "path": "/esi/v1", "target": "http://localhost:8080", "label": "nest", "envKey": "NEST_URL" }
      ]
    }
  }
}
