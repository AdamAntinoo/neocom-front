#!/usr/bin/env bash
# Sync package/app version from GitVersion MajorMinorPatch into the same commit.
set -euo pipefail

if [[ "${SKIP_VERSION_SYNC:-}" == "1" ]]; then
  exit 0
fi

if ! command -v gitversion >/dev/null 2>&1; then
  echo "pre-commit: gitversion not on PATH — skipping version:sync (CI hook will sync)." >&2
  exit 0
fi

root="$(git rev-parse --show-toplevel)"
cd "$root"

npm run version:sync

# Stage version artefacts so they land in this commit.
for path in \
  package.json \
  src/environments/environment.ts \
  src/environments/environment.development.ts \
  src/index.html \
  cypress/e2e/features/app-info-panel.feature \
  .app-banner.txt
do
  if [[ -f "$path" ]]; then
    git add -- "$path"
  fi
done
