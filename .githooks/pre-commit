#!/usr/bin/env bash
# pre-commit — keep app SemVer aligned with GitVersion on every local commit.
#
# When this runs
#   - Installed by `npm prepare` → `git config core.hooksPath .githooks`
#   - Git invokes this hook automatically before creating a commit (any branch)
#   - CI also syncs on push via `.github/workflows/version-sync.yml` (safety net)
#
# What it does
#   1. Exit early if SKIP_VERSION_SYNC=1 (escape hatch for rare local skips)
#   2. Exit early if `gitversion` is not on PATH (CI will sync later)
#   3. Run `npm run version:sync`, which:
#        - reads GitVersion MajorMinorPatch (X.Y.Z only)
#        - writes that into environment appVersion fields, index.html loading text,
#          Cypress app-version expectations, and banner
#        - does NOT rewrite package.json (stays 0.0.0 for CI node_modules cache)
#   4. `git add` those version artefacts so the bump is included in this commit
#
# Do not hand-edit SemVer or invent a chore(version) commit — this hook owns it.
set -euo pipefail

if [[ "${SKIP_VERSION_SYNC:-}" == "1" ]]; then
  exit 0
fi

if ! command -v gitversion >/dev/null 2>&1; then
  echo "pre-commit: gitversion not on PATH — skipping version:sync (CI hook will sync)." >&2
  exit 0
fi

root="$(git rev-parse --show-toplevel)"
cd "$root"

npm run version:sync

# Stage version artefacts so they land in this commit (never package.json).
for path in \
  src/environments/environment.ts \
  src/environments/environment.development.ts \
  src/index.html \
  cypress/e2e/features/login.feature \
  cypress/e2e/features/industry-blueprints-by-location.feature \
  .app-banner.txt
do
  if [[ -f "$path" ]]; then
    git add -- "$path"
  fi
done
